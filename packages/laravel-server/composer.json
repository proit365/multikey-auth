{
  "name": "realmatrix/laravel-multikey-auth-server",
  "description": "Laravel 12 server adapter for ProIT365 MultiKey Auth MKAP v1",
  "homepage": "https://github.com/proit365/multikey-auth",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/cache": "^12.0",
    "illuminate/console": "^12.0",
    "illuminate/database": "^12.0",
    "illuminate/routing": "^12.0",
    "illuminate/support": "^12.0",
    "realmatrix/multikey-auth-server": "^1.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.5"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../server",
      "options": {
        "versions": {
          "realmatrix/multikey-auth-server": "1.0.x-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "../core",
      "options": {
        "versions": {
          "realmatrix/multikey-auth-core": "1.0.x-dev"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "ProIT365\\MultiKeyAuth\\LaravelServer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ProIT365\\MultiKeyAuth\\LaravelServer\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "ProIT365\\MultiKeyAuth\\LaravelServer\\MultiKeyAuthServiceProvider"
      ]
    }
  }
}
