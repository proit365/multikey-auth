{
  "name": "proit365/laravel-multikey-auth-server",
  "description": "Laravel 12 server integration for ProIT365 MultiKey Auth (MKAP), with challenge routes, authentication middleware, and key administration commands.",
  "homepage": "https://github.com/proit365/multikey-auth",
  "keywords": ["authentication", "laravel", "mkap", "php", "server", "proit365"],
  "type": "library",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/proit365/multikey-auth/issues",
    "source": "https://github.com/proit365/multikey-auth/tree/main/packages/laravel-server",
    "docs": "https://github.com/proit365/multikey-auth/tree/main/packages/laravel-server"
  },
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "illuminate/cache": "^12.0",
    "illuminate/console": "^12.0",
    "illuminate/database": "^12.0",
    "illuminate/routing": "^12.0",
    "illuminate/support": "^12.0",
    "proit365/multikey-auth-server": "^1.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "ProIT365\\MultiKeyAuth\\LaravelServer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ProIT365\\MultiKeyAuth\\LaravelServer\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "ProIT365\\MultiKeyAuth\\LaravelServer\\MultiKeyAuthServiceProvider"
      ]
    }
  }
}
