{
    "name": "proit365/multikey-auth-core",
    "description": "PHP cryptographic and key-management core for ProIT365 MultiKey Auth (MKAP), implementing protocol primitives, key pools, exports, and storage adapters.",
    "homepage": "https://github.com/proit365/multikey-auth",
    "keywords": ["authentication", "cryptography", "mkap", "proit365"],
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/proit365/multikey-auth/issues",
        "source": "https://github.com/proit365/multikey-auth/tree/main/packages/core",
        "docs": "https://github.com/proit365/multikey-auth-core/blob/main/docs/guide.md"
    },
    "require": {
        "php": "^8.2",
        "ext-openssl": "*"
    },
    "suggest": {
        "ext-mysqli": "Required only when using MysqliKeyRepository.",
        "ext-pdo": "Required only when using PdoKeyRepository."
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "ProIT365\\MultiKeyAuth\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ProIT365\\MultiKeyAuth\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}