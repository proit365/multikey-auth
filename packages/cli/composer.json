{
  "name": "proit365/multikey-auth-cli",
  "description": "Administrative PHP CLI for ProIT365 MultiKey Auth (MKAP), with client and pool management, key lifecycle operations, exports, challenge cleanup, and audit records.",
  "homepage": "https://github.com/proit365/multikey-auth",
  "keywords": ["administration", "authentication", "cli", "mkap", "php", "proit365"],
  "type": "library",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/proit365/multikey-auth/issues",
    "source": "https://github.com/proit365/multikey-auth/tree/main/packages/cli",
    "docs": "https://github.com/proit365/multikey-auth-cli/blob/main/docs/guide.md"
  },
  "bin": [
    "bin/mkap"
  ],
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "proit365/multikey-auth-core": "^1.0",
    "proit365/multikey-auth-server": "^1.0"
  },
  "require-dev": {
    "ext-pdo_sqlite": "*"
  },
  "autoload": {
    "psr-4": {
      "ProIT365\\MultiKeyAuth\\Cli\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/manual-phase12.php"
  }
}
