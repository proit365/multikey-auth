{
  "name": "realmatrix/multikey-auth",
  "description": "PHP client SDK for ProIT365 MultiKey Auth MKAP v1",
  "homepage": "https://github.com/proit365/multikey-auth",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "realmatrix/multikey-auth-core": "^1.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../core",
      "options": {
        "versions": {
          "realmatrix/multikey-auth-core": "1.0.x-dev"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "ProIT365\\MultiKeyAuth\\Client\\": "src/"
    }
  }
}
