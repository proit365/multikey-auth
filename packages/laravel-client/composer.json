{
  "name": "proit365/laravel-multikey-auth",
  "description": "Laravel 12 client integration for ProIT365 MultiKey Auth (MKAP), providing a configured PHP client and facade for challenge-response API authentication.",
  "homepage": "https://github.com/proit365/multikey-auth",
  "keywords": ["authentication", "client", "laravel", "mkap", "php", "proit365"],
  "type": "library",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/proit365/multikey-auth/issues",
    "source": "https://github.com/proit365/multikey-auth/tree/main/packages/laravel-client",
    "docs": "https://github.com/proit365/multikey-auth/tree/main/packages/laravel-client"
  },
  "require": {
    "php": "^8.2",
    "illuminate/http": "^12.0",
    "illuminate/support": "^12.0",
    "proit365/multikey-auth": "^1.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "ProIT365\\MultiKeyAuth\\LaravelClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ProIT365\\MultiKeyAuth\\LaravelClient\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "ProIT365\\MultiKeyAuth\\LaravelClient\\MultiKeyAuthClientServiceProvider"
      ],
      "aliases": {
        "MKAP": "ProIT365\\MultiKeyAuth\\LaravelClient\\Facades\\MKAP"
      }
    }
  }
}
