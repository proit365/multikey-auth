{
  "name": "realmatrix/multikey-auth-cli",
  "description": "Framework-independent administrative CLI for ProIT365 MultiKey Auth",
  "homepage": "https://github.com/proit365/multikey-auth",
  "type": "library",
  "license": "MIT",
  "bin": [
    "bin/mkap"
  ],
  "require": {
    "php": "^8.2",
    "realmatrix/multikey-auth-core": "^1.0",
    "realmatrix/multikey-auth-server": "^1.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../core",
      "options": {
        "versions": {
          "realmatrix/multikey-auth-core": "1.0.x-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "../server",
      "options": {
        "versions": {
          "realmatrix/multikey-auth-server": "1.0.x-dev"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "ProIT365\\MultiKeyAuth\\Cli\\": "src/"
    }
  },
  "scripts": {
    "test": "php tests/manual-phase12.php"
  }
}
